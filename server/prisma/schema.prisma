// Heygotchu backend schema.
//
// Design notes:
// - Every user-owned table carries a `userId` foreign key with `onDelete:
//   Cascade`, and every route that reads/writes them filters by the
//   authenticated user's id — that's what keeps each account's closet,
//   preferences, and saved plans fully isolated from every other account.
// - `ClothingItem.tags` / `.coverage`, `ClothingPreferences.data`, and
//   `EventPlan.data` are stored as `String` columns holding JSON-serialized
//   text (see the serialize/deserialize helpers next to each route), rather
//   than Prisma's native `Json` scalar or fully relational columns. This is
//   a deliberate choice: it lets the API mirror the frontend's existing
//   TypeScript shapes (CoverageProfile, ClothingPreferences, TripPlan,
//   OccasionPlan) closely without a large relational migration, and —
//   unlike Prisma's `Json` type, which SQLite's connector doesn't support at
//   all — plain `String` columns behave identically on SQLite (used for
//   local development) and PostgreSQL (the shipped target), so what's
//   tested locally is the same code path that runs in production.
// - `EventPlan` covers BOTH destination trips and occasions via `mode`
//   ('destination' | 'occasion'); the full plan payload is stored as JSON.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  // Optional second identifier: acts purely as a username for login,
  // exactly like email does. No OTP/SMS is ever sent to it.
  phoneNumber  String?  @unique
  passwordHash String
  // True once the user has verified their email via OTP — that's what
  // unlocks login.
  verified     Boolean  @default(false)
  // 'user' | 'admin' — admins can see and manage every family account via
  // the /admin routes and the frontend admin panel.
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Login streak, counted in whole days (Asia/Kolkata): opening the app on
  // consecutive days grows it, a missed day resets it to 1. Tier thresholds
  // (Silver → Diamond) are derived from streakCount in the /streak route.
  streakCount   Int     @default(0)
  bestStreak    Int     @default(0)
  lastActiveDay String? // 'YYYY-MM-DD' of the last counted day
  // Referral ("refer & earn 5 Daily Grind days"): set once at signup to the
  // referrer's user id — its presence is what stops double-crediting.
  referredById  String?

  otpCodes    OtpCode[]
  closetItems ClothingItem[]
  preferences ClothingPreferences?
  eventPlans  EventPlan[]
  aiRuns      AiRun[]
  savedDates  SavedDate[]
}

// "Save the date": a trip or occasion pinned to a calendar date, with a
// reminder ladder (days-before-event marks, e.g. [5,2,1,0]) the app
// surfaces as the date approaches.
model SavedDate {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  kind        String // 'occasion' | 'trip'
  date        String // 'YYYY-MM-DD'
  reminders   String // JSON-serialized number[] of days-before marks
  eventPlanId String? // optional link to a saved EventPlan
  createdAt   DateTime @default(now())

  @@index([userId, date])
}

// One row per AI call (tagging, suggestions, outfits, selfie analysis) —
// used to enforce the per-user daily AI limit. Admins are exempt.
model AiRun {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model OtpCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model ClothingItem {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  category     String
  gender       String
  color        String
  warmth       String
  formality    String
  weatherproof Boolean  @default(false)
  tags         String // JSON-serialized string[]
  coverage     String? // JSON-serialized CoverageProfile
  photo        String? // data URL, optional
  // True once the photo has been background-cleaned and cropped — the
  // durable done-marker that stops any client from ever re-processing it.
  photoCleaned Boolean  @default(false)
  source       String   @default("manual") // 'manual' | 'ai-tagged'
  createdAt    DateTime @default(now())

  @@index([userId])
}

model ClothingPreferences {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      String // JSON-serialized ClothingPreferences object
  updatedAt DateTime @updatedAt
}

model EventPlan {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode      String // 'destination' | 'occasion'
  title     String // destination name, or occasion type/label — for list views
  data      String // JSON-serialized TripPlan or OccasionPlan payload
  createdAt DateTime @default(now())

  @@index([userId])
}
