# Copy this file to .env and fill in the values you have. Anything left
# blank falls back to "dev mode" as documented in server/README.md — the app
# stays fully runnable with just DATABASE_URL and JWT_SECRET set.

# Required -------------------------------------------------------------

# PostgreSQL connection string. The easiest free option is Neon
# (https://neon.tech) — create a project, copy its connection string here.
# Must include ?sslmode=require for Neon.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Any long random string — used to sign login sessions (JWTs). Generate one
# with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Optional ---------------------------------------------------------------

PORT=4000
# Comma-separated list, or "*" for any origin (fine for local development).
CORS_ORIGIN=*

# Claude API — powers photo auto-tagging and "beyond your closet"
# suggestions. Without it, those two endpoints return a clear 503 and
# everything else keeps working normally.
ANTHROPIC_API_KEY=

# Email OTP delivery via Resend (https://resend.com — has a free tier).
# Without these, OTP emails aren't actually sent — the code is logged to the
# server console and returned in the API response instead ("dev mode"), so
# signup/login still work end-to-end during development.
RESEND_API_KEY=
EMAIL_FROM="Heygotchu <onboarding@resend.dev>"

OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
MAX_UPLOAD_BYTES=8388608
