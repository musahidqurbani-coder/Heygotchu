# Heygotchu frontend environment variables
#
# The frontend only needs to know where the backend API lives — every real
# secret (database, JWT signing key, Claude/email provider keys) lives
# server-side in server/.env instead (see server/.env.example), never here.

# Base URL of the Heygotchu backend (see /server). Defaults to
# http://localhost:4000 when unset, which matches the backend's own default
# dev port — so running `npm run dev` in both folders needs no configuration
# at all. Set this to your deployed backend's URL in production.
VITE_API_URL=http://localhost:4000
